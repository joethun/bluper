# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# asdf version management
.tool-versions

# Node / Bun
node_modules

# Turborepo
.turbo

# Env vars (keep .env.example tracked)
.env*
!*.env.example

# wasm-pack writes `pkg/` (including its own .gitignore holding `*`), so the
# built renderer is never committed — every build makes it. `bun run build:wasm`
# has to run before `bun install` on a fresh clone, or the `file:` dependency on
# it resolves to nothing.

# Cursor
.cursor/
.cursorignore

# OpenNext
.open-next

# Cargo
target/
.cargo-tools/

# Internal
rust-migration-notes.md

# Next.js static export (regenerated by `bun run build:web:export`)
apps/web/out/

# TypeScript incremental build info
*.tsbuildinfo

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini
