{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"src/app/**/{page,layout,route,default,error,not-found,global-error,template,loading,sitemap,robots,opengraph-image,icon,apple-icon,manifest}.{ts,tsx}",
		"scripts/**/*.ts",
		"src/**/__tests__/**/*.{ts,tsx}",
		"src/**/*.test.{ts,tsx}",
		"src/types/**/*.d.ts"
	],
	"project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
	"ignore": [
		"content-collections.ts",
		"open-next.config.ts"
	],
	"ignoreBinaries": [
		"opennextjs-cloudflare",
		"eslint",
		"prettier"
	],
	"ignoreDependencies": [
		"sharp",
		"@napi-rs/canvas",
		"wrangler",
		"tailwindcss-animate",
		"@tailwindcss/typography",
		"tailwindcss"
	]
}
